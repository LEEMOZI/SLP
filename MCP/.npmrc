# ============================================================
# MCP 项目级 pnpm 配置
#
# MCP/harness/plugins/* 是我们为 DeepSeek Harness 开发的 Cordis 插件/Bundle 代码，
# 开发时会跑 pnpm install / tsc --build，为避免写入沙盒黑名单 ~/Library 或 ~/.local，
# 这里把 store/cache/state/global 全指向项目相对目录。
#
# 键名采用 pnpm 11 官方环境变量等价写法：
#   PNPM_STORE_DIR  →  store_dir=.pnpm-store
# （store-dir/cache-dir 等"减号分隔"的短名在 pnpm 11 + XDG fallback 并存时会返回 undefined，
#  经实测必须用下划线形式。）
# ============================================================
store_dir=../.pnpm-store
cache_dir=../.cache/pnpm
state_dir=../.pnpm-home/state
global_dir=../.pnpm-home/global
use-stderr=true
prefer-offline=true
