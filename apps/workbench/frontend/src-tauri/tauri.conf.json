{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLP 法律工作台",
  "version": "0.2.0",
  "identifier": "com.slp.workbench",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "http://127.0.0.1:8780"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SLP 法律工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/binaries/*": "binaries/",
      "resources/frontend-dist/**/*": "frontend/dist/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LEEMOZI/SLP/releases/download/v{{version}}/slp-workbench_{{version}}_{{target}}-{{arch}}.app.tar.gz"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5MTUyQjlGOTVBRDYyQ0MKUldUTVlxMlZueXNWK1RhRnFFQmNvK3FGMFRYb2tvQUZaTlFTcWJHNGMybzFialdUd20rWjRyWFoK"
    }
  }
}
