{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLP 法律工作台",
  "version": "0.1.0",
  "identifier": "com.slp.workbench",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "http://127.0.0.1:8780"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SLP 法律工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ]
  }
}
