{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "window-state:default",
    "dialog:default",
    "updater:default",
    {
      "identifier": "fs:default",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    }
  ]
}
