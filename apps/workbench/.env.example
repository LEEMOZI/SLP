# SLP 法律工作台 - 环境变量配置
# 复制为 .env 并修改值

# === 内部通信 ===
# sidecar 与 workbench 之间的内部 token（必须一致）
SLP_CAPABILITY_ADAPTER_TOKEN=local-internal-token
# sidecar 地址
SLP_CAPABILITY_ADAPTER_URL=http://127.0.0.1:8790

# === LLM 管线（摘要/审查/诉讼文书生成）===
# 提供商: openai-compatible | builtin-extractive
SLP_SUMMARY_PROVIDER=openai-compatible
# OpenAI 兼容 API 地址（LM Studio 默认 http://127.0.0.1:1235/v1）
SLP_SUMMARY_OPENAI_BASE_URL=http://127.0.0.1:1235/v1
# API Key（LM Studio 本地可留空）
SLP_SUMMARY_OPENAI_API_KEY=
# 主力模型
SLP_SUMMARY_MODEL=qwen3.6-35b-a3b
# 高质量模型（可选，用于复杂任务）
SLP_SUMMARY_QUALITY_MODEL=qwen3.8-27b

# === 数据目录（可选）===
# 案件材料存储目录（默认 ~/.slp-workbench/dev/files/cases）
# SLP_WORKBENCH_DATA_DIR=/path/to/data
# 裁判文书数据库目录（默认 <项目根>/MCP/judgment-search/data/judgments）
# SLP_JUDGMENT_DB_DIR=/path/to/judgments

# === 分发版专用（Tauri 自动设置，无需手动配置）===
# SLP_FRONTEND_DIST=/path/to/frontend/dist
# SLP_PROJECT_ROOT=/path/to/project
